# 复制为 .env 后填入自己的 key。.env 不提交（见 .gitignore）。
#
# 任何 OpenAI 兼容的 /chat/completions 端点都可以用，例如官方 DeepSeek、
# 自建中转站、或本机的 vLLM / one-api 网关。
#
# MYAGENT_PROVIDER 用来选预设：deepseek / openai / moonshot / gateway / custom
#   - 选了预设后，model 和 base_url 可以省略，由预设补齐
#   - custom 必须自己写全 model 和 base_url

MYAGENT_PROVIDER=gateway
MYAGENT_MODEL=deepseek-v4.1-flash
MYAGENT_BASE_URL=http://127.0.0.1:7864/v1
MYAGENT_API_KEY=sk-your-key-here
